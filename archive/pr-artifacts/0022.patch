@@ -970,6 +994,38 @@ function setCardMeta(id, visible, detail = '') {
   bindMetaInfoInteractions(el);
 }
 
+function setCostMeta(id, pricedCount, modelCount, detail = '') {
+  const el = document.getElementById(id);
+  if (!el) return;
+  const priced = Number(pricedCount || 0);
+  const total = Number(modelCount || 0);
+  const partial = priced > 0 && priced < total;
+  const visible = priced
+    ? `${priced} of ${total} models priced`
+    : 'No matched pricing';
+  const detailText = String(detail || '');
+  const tooltipId = `${id}-tooltip`;
+  el.innerHTML = `
+    <span class="estimate-meta">
+      ${partial ? '<span class="estimate-badge">Partial estimate</span>' : ''}
+      <span class="estimate-coverage">${escapeHtml(visible)}</span>
+    </span>
+    ${detailText ? `
+      <span class="meta-info-wrap">
