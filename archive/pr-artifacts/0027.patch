 }
 
+function fmtPercent(value) {
+  if (!Number.isFinite(value)) return '0%';
+  if (value > 0 && value < 1) return '<1%';
+  return `${Math.round(value)}%`;
+}
+
+function fmtPeriod(days = currentDays) {
+  return Number(days) === 0 ? 'All-time' : `${days}d`;
+}
+
+function fmtDateLabel(dateString) {
+  if (!dateString) return '—';
+  const date = new Date(`${dateString}T00:00:00`);
+  if (Number.isNaN(date.getTime())) return dateString;
+  return DATE_FORMATTER.format(date);
+}
+
+function effectiveTokens(value) {
+  return Number(value?.tokens_effective_total ?? value?.tokens_total ?? 0);
+}
+
+function computeDailySummary(data) {
+  const dates = data?.dates || [];
+  let peak = { date: null, total: 0 };
+  let total = 0;
+  dates.forEach(date => {
+    const dayRows = Object.values(data?.data?.[date] || {});
+    const dayTotal = dayRows.reduce((sum, row) => sum + effectiveTokens(row), 0);
+    total += dayTotal;
+    if (dayTotal > peak.total) peak = { date, total: dayTotal };
+  });
+  return { total, peak };
+}
+
+function topContributorsForTooltip(contexts) {
+  return contexts
+    .filter(ctx => Number(ctx.raw || 0) > 0)
+    .sort((a, b) => Number(b.raw || 0) - Number(a.raw || 0))
+    .slice(0, 3)
+    .map(ctx => ` ${ctx.dataset.label}: ${fmtTokens(ctx.raw)}`);
+}
+
+function pricingCoverageLabel(coverage = currentCostCoverage) {
+  if (!coverage) return 'Pricing coverage loading';
+  if (!coverage.modelCount) return 'Pricing unavailable';
+  if (coverage.unpricedCount > 0 || coverage.partialCount > 0) {
+    return `Cost estimate partial: ${coverage.pricedCount}/${coverage.modelCount} models priced`;
+  }
+  return `Cost estimate complete: ${coverage.modelCount}/${coverage.modelCount} models priced`;
+}
+
+function pricingCoverageClass(coverage = currentCostCoverage) {
+  return coverage && (coverage.unpricedCount > 0 || coverage.partialCount > 0) ? 'usage-warning' : '';
+}
+
+function renderUsageSummary() {
+  const primary = document.getElementById('usage-summary-primary');
+  const secondary = document.getElementById('usage-summary-secondary');
+  const next = document.getElementById('usage-summary-next');
+  if (!primary || !secondary || !next || !currentOverview) return;
+
+  const totalTokens = Number(currentOverview.total_tokens || 0);
+  const cacheTotal = Number(currentOverview.cache_total || 0);
+  const cachePercent = totalTokens ? fmtPercent((cacheTotal / totalTokens) * 100) : '0%';
+  const activeSources = (currentOverview.tool_sources || []).filter(source => source.sessions !== null && source.sessions !== undefined);
+  const topSource = activeSources
+    .slice()
+    .sort((a, b) => Number(b.tokens_total || 0) - Number(a.tokens_total || 0))[0];
+  const topSourceLabel = topSource?.label || currentOverview.active_tool_label || 'No source';
+
+  const modelDenominator = currentModels.reduce((sum, model) => sum + effectiveTokens(model), 0);
+  const topModel = currentModels.slice().sort((a, b) => effectiveTokens(b) - effectiveTokens(a))[0];
+  const topModelShare = topModel && modelDenominator ? fmtPercent((effectiveTokens(topModel) / modelDenominator) * 100) : '0%';
+  const peak = overviewDailySummary?.peak || { date: null, total: 0 };
+  const coverage = pricingCoverageLabel();
+  const coverageClass = pricingCoverageClass();
+  const nextText = currentCostCoverage?.unpricedCount > 0 || currentCostCoverage?.partialCount > 0
+    ? 'Next: inspect unpriced or partial model costs'
+    : topModel
+    ? `Next: inspect ${topModel.label}`
+    : 'Next: inspect model breakdown';
+
+  primary.innerHTML = `
+    <span class="usage-number">${escapeHtml(fmtPeriod())}</span> usage:
+    <span class="usage-number">${escapeHtml(fmtTokens(totalTokens))}</span> tokens ·
+    <span class="usage-number">${escapeHtml(cachePercent)}</span> cached ·
+    ${escapeHtml(topSourceLabel)} leads ·
+    ${topModel ? `${escapeHtml(topModel.label)} is <span class="usage-number">${escapeHtml(topModelShare)}</span> of volume` : 'model share loading'}
+  `;
+  secondary.innerHTML = `
+    Peak day: <span class="usage-number">${escapeHtml(fmtDateLabel(peak.date))}</span> ·
+    <span class="usage-number">${escapeHtml(fmtTokens(peak.total))}</span> tokens ·
+    <span class="${coverageClass}">${escapeHtml(coverage)}</span>
+  `;
+  next.innerHTML = `<span class="usage-next">${escapeHtml(nextText)}</span>`;
+}
