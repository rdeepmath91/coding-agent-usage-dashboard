+  <script>
+    (() => {
+      const form = document.getElementById('filter-form');
+      const rangeButtons = [...document.querySelectorAll('.range-button')];
+      const activeFilters = document.getElementById('active-filters');
+      const drawer = document.getElementById('detail-drawer');
+      const closeDetail = document.getElementById('close-detail');
+      let lastTrigger = null;
+
+      const labels = {
+        tool: 'Tool',
+        model: 'Model',
+        project: 'Project',
+        search: 'Search'
+      };
+
+      function setRange(button) {
+        rangeButtons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
+        const existing = activeFilters.querySelector('[data-filter-chip="range"]');
+        const value = button.dataset.days === 'all' ? 'All time' : button.dataset.days === 'custom' ? 'Explicit dates' : `${button.dataset.days} days`;
+        if (existing) existing.firstChild.textContent = `Range: ${value} `;
+      }
+
+      function setChip(key, value) {
+        const existing = activeFilters.querySelector(`[data-filter-chip="${key}"]`);
+        if (!value) {
+          if (existing) existing.remove();
+          return;
+        }
+        if (existing) {
+          existing.firstChild.textContent = `${labels[key]}: ${value} `;
+          return;
+        }
+        const chip = document.createElement('span');
+        chip.className = 'chip';
+        chip.dataset.filterChip = key;
+        chip.append(document.createTextNode(`${labels[key]}: ${value} `));
+        const remove = document.createElement('button');
+        remove.type = 'button';
+        remove.setAttribute('aria-label', `Clear ${labels[key].toLowerCase()} filter`);
+        remove.textContent = '×';
+        chip.append(remove);
+        activeFilters.insertBefore(chip, document.getElementById('clear-all'));
+      }
+
+      rangeButtons.forEach(button => button.addEventListener('click', () => setRange(button)));
+
+      form.addEventListener('submit', event => {
+        event.preventDefault();
+        setChip('tool', document.getElementById('tool-filter').value);
+        setChip('model', document.getElementById('model-filter').value);
+        setChip('project', document.getElementById('project-filter').value);
+        setChip('search', document.getElementById('search-filter').value.trim());
+      });
+
+      activeFilters.addEventListener('click', event => {
+        const button = event.target.closest('.chip button');
+        if (!button) return;
+        const chip = button.closest('.chip');
+        const key = chip.dataset.filterChip;
+        if (key === 'range') {
+          setRange(rangeButtons.find(item => item.dataset.days === '30'));
+          return;
+        }
+        const control = document.getElementById(`${key}-filter`);
+        if (control) control.value = '';
+        chip.remove();
+      });
+
+      document.getElementById('clear-all').addEventListener('click', () => {
+        [...activeFilters.querySelectorAll('.chip')].forEach(chip => chip.remove());
+        ['tool-filter', 'model-filter', 'project-filter', 'search-filter'].forEach(id => document.getElementById(id).value = '');
+        rangeButtons.forEach(item => item.setAttribute('aria-pressed', 'false'));
+      });
+
+      document.querySelectorAll('.bar').forEach(bar => bar.addEventListener('click', () => {
+        document.querySelectorAll('.bar').forEach(item => item.setAttribute('aria-pressed', String(item === bar)));
+        setChip('search', `Date ${bar.dataset.label}`);
+      }));
+
+      document.getElementById('show-table').addEventListener('click', event => {
+        const table = document.getElementById('chart-table');
+        table.hidden = !table.hidden;
+        event.currentTarget.textContent = table.hidden ? 'Show data table' : 'Hide data table';
+      });
+
+      function openDrawer(trigger) {
+        lastTrigger = trigger;
+        document.getElementById('detail-title').textContent = trigger.dataset.session;
+        drawer.hidden = false;
+        closeDetail.focus();
+      }
+
+      function hideDrawer() {
+        drawer.hidden = true;
+        if (lastTrigger) lastTrigger.focus();
+      }
+
+      document.querySelectorAll('.session-button').forEach(button => button.addEventListener('click', () => openDrawer(button)));
+      closeDetail.addEventListener('click', hideDrawer);
+      document.addEventListener('keydown', event => {
+        if (event.key === 'Escape' && !drawer.hidden) hideDrawer();
+      });
+    })();
+  </script>
