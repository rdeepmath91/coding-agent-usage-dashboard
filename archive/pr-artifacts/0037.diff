+def cursor_source_available() -> bool:
+    """Return whether local Cursor composer state with token rows exists."""
+    state_path = Path(CURSOR_STATE_PATH)
+    if not state_path.exists():
+        return False
+    try:
+        conn = sqlite3.connect(f"file:{CURSOR_STATE_PATH}?mode=ro", uri=True)
+        try:
+            row = conn.execute(
+                """
+                SELECT 1
+                FROM cursorDiskKV
+                WHERE key LIKE 'composerData:%'
+                  AND (
+                    (CAST(value AS TEXT) LIKE '%tokenCount%' AND CAST(value AS TEXT) LIKE '%inputTokens%')
+                    OR CAST(value AS TEXT) LIKE '%promptTokenBreakdown%'
+                    OR CAST(value AS TEXT) LIKE '%contextTokensUsed%'
+                  )
+                LIMIT 1
+                """
+            ).fetchone()
+            if row:
+                return True
+        finally:
+            conn.close()
+    except sqlite3.Error:
+        return False
+    return False
+
