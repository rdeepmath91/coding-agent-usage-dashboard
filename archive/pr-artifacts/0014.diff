-                model_provider,
-                model,
-                title,
-                cwd,
-                preview,
-                tokens_used
-            FROM threads
-            {where}
-            ORDER BY COALESCE(updated_at_ms, updated_at * 1000, created_at_ms, created_at * 1000) DESC
